{
  "name": "spodrive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @spodrive/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "spodrive": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
