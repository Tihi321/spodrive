# OAuth 2.0 *Web application* client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=
# API key (restricted to HTTP referrers and the Picker API) used by the Google Picker
VITE_GOOGLE_API_KEY=
# Google Cloud project number (the Picker "App ID")
VITE_GOOGLE_APP_ID=
# Public base path. "/" for localhost/custom domain, "/<repo>/" for GitHub Pages project sites
VITE_BASE=/
